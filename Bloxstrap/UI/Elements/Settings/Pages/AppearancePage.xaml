<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.AppearancePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
 Title="Appearance" Scrollable="True">
 <StackPanel Margin="0,0,14,14">
  <TextBlock Text="Make the depths your own" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8" />
  <TextBlock Text="Crimson Contract uses Chaser's cathedral artwork. Every other theme uses a simple solid color." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,18" />
  <controls:OptionControl Header="Theme" Description="Changes the app and its launcher immediately. Save to keep your choice.">
   <ComboBox Width="220" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme, Mode=TwoWay}" Padding="10,6">
    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumNameConverter}}" /></DataTemplate></ComboBox.ItemTemplate>
   </ComboBox>
  </controls:OptionControl>
  <Border Margin="0,12,0,18" CornerRadius="12" ClipToBounds="True" Background="#180D10">
   <StackPanel>
    <Image Source="pack://application:,,,/Resources/Brand/CrimsonContract.png" Stretch="Uniform" />
    <StackPanel Orientation="Horizontal" Margin="16,12">
     <Image Source="pack://application:,,,/Resources/Brand/DepthStrap.png" Width="38" Height="38" Margin="0,0,12,0" />
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="Crimson Contract" FontWeight="SemiBold" />
      <TextBlock Text="DepthStrap • GloryToBloodrend" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
     </StackPanel>
    </StackPanel>
   </StackPanel>
  </Border>
  <controls:OptionControl Header="App font" Description="Choose your own font for the interface.">
   <StackPanel Orientation="Horizontal">
    <ui:Button Content="Choose font" Command="{Binding ManageCustomFontCommand}" CommandParameter="Choose" Padding="12,6" />
    <ui:Button Content="Reset font" Command="{Binding ManageCustomFontCommand}" CommandParameter="Remove" Padding="12,6" Margin="8,0,0,0" />
   </StackPanel>
  </controls:OptionControl>
  <controls:OptionControl Header="Language">
   <ComboBox Width="220" ItemsSource="{Binding Languages}" Text="{Binding SelectedLanguage, Mode=TwoWay}" Padding="10,6" />
  </controls:OptionControl>
 </StackPanel>
</ui:UiPage>
