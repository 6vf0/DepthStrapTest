<base:WpfUiWindow x:Class="Bloxstrap.UI.Elements.Bootstrapper.DepthStrapDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="720" Height="420" ResizeMode="NoResize" ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None" WindowStartupLocation="CenterScreen" Closing="OnClosing">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding TaskbarProgressState}" ProgressValue="{Binding TaskbarProgressValue}" />
    </Window.TaskbarItemInfo>
    <Grid Background="{DynamicResource ApplicationBackground}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <ui:TitleBar Title="DepthStrap" Icon="pack://application:,,,/DepthStrap.ico" ShowMaximize="False" CanMaximize="False" Padding="8" />
        <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="388"
                Margin="24,24,24,45" Padding="22" CornerRadius="12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Resources/Brand/DepthStrap.png" Width="44" Height="44" Margin="0,0,14,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DEPTHSTRAP" FontSize="23" FontWeight="SemiBold" />
                        <TextBlock Text="Prepare for the depths" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,22,0,12" />
                <ProgressBar Height="5" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}" IsIndeterminate="{Binding ProgressIndeterminate}" />
                <ui:Button Content="Cancel" HorizontalAlignment="Left" Margin="0,16,0,0" Padding="14,6"
                           Visibility="{Binding CancelButtonVisibility}" IsEnabled="{Binding CancelEnabled}" Command="{Binding CancelInstallCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
